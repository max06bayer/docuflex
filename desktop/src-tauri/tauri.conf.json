{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docuflex",
  "version": "0.0.1",
  "identifier": "com.docuflex.editor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": ["resources/**/*"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF Document",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
