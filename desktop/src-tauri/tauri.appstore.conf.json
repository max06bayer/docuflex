{
  "app": {
    "security": {
      "capabilities": [
        {
          "$schema": "../gen/schemas/desktop-schema.json",
          "identifier": "app-store-window",
          "description": "Native document access for the Mac App Store editor; no external updater.",
          "remote": {
            "urls": [
              "http://127.0.0.1:43127/*"
            ]
          },
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "allow-take-pending-pdf",
            "allow-start-window-drag",
            "allow-macos-resize-window",
            "allow-docuflex-save-prompt",
            "allow-docuflex-save-overwrite",
            "allow-docuflex-print-pdf",
            "allow-docuflex-import-local-data",
            "allow-docuflex-read-local-file"
          ]
        }
      ]
    }
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "resources": {
      "../.app-store/resources/": "resources/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "bundleVersion": "1"
    }
  }
}
