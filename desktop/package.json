{
  "name": "docuflex-desktop-build",
  "private": true,
  "version": "0.9.6",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "stage": "node scripts/prepare.mjs",
    "smoke": "node scripts/smoke-runtimes.mjs",
    "bundle": "node scripts/build.mjs",
    "build": "npm run stage && npm run smoke && npm run bundle",
    "dev": "npm run stage && tauri dev",
    "bundle:redesign": "DOCUFLEX_VARIANT=redesign node scripts/build.mjs",
    "build:redesign": "npm run stage && npm run smoke && npm run bundle:redesign",
    "stage:appstore": "DOCUFLEX_DISTRIBUTION=app-store node scripts/prepare.mjs",
    "build:appstore": "DOCUFLEX_DISTRIBUTION=app-store npm run build",
    "build:appstore:qa": "DOCUFLEX_DISTRIBUTION=app-store DOCUFLEX_APP_STORE_LOCAL_QA=1 npm run build",
    "bundle:appstore": "DOCUFLEX_DISTRIBUTION=app-store node scripts/build.mjs",
    "check:appstore": "node scripts/check-app-store.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "pngjs": "7.0.0"
  }
}
