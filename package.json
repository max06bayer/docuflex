{
  "name": "docuflex",
  "private": true,
  "version": "0.9.3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "backend:compile": "javac -cp backend/lib/pdfbox-app-3.0.8.jar -d backend/out backend/src/DocuflexPdfServer.java",
    "backend:dev": "npm run backend:compile && java -cp backend/out:backend/lib/pdfbox-app-3.0.8.jar DocuflexPdfServer",
    "backend:start": "java -cp backend/out:backend/lib/pdfbox-app-3.0.8.jar DocuflexPdfServer",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "frontend:start": "node build",
    "start": "bash scripts/start-unprivileged.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.186.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.0.0",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/roboto": "^5.3.0",
    "mathjax": "^3.2.2",
    "maxmind": "^4.3.29",
    "pdfjs-dist": "^6.2.108",
    "three": "^0.186.1"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
