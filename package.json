{
  "name": "docuflex",
  "private": true,
  "version": "0.9.5",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "backend:compile": "javac -cp backend/lib/pdfbox-app-3.0.8.jar -d backend/out backend/src/DocuflexPdfServer.java",
    "backend:dev": "npm run backend:compile && java -cp backend/out:backend/lib/pdfbox-app-3.0.8.jar DocuflexPdfServer",
    "backend:start": "java -cp backend/out:backend/lib/pdfbox-app-3.0.8.jar DocuflexPdfServer",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "frontend:start": "node build",
    "start": "bash scripts/start-unprivileged.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.5",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "mathjax": "^3.2.2",
    "maxmind": "^5.0.7",
    "pdfjs-dist": "^6.4.299",
    "three": "^0.186.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
